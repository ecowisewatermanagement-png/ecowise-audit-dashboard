# Supabase (free tier project — https://supabase.com/dashboard)
# Project Settings → API → "Publishable and secret API keys" tab
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # the "Publishable key" (sb_publishable_...)

# Server-only — the "Secret key" (sb_secret_...). Used for admin actions
# (inviting clients, CSV import). Never expose this to the client.
SUPABASE_SECRET_KEY=
